/**
 * 价格格式化工具
 */
function normalizePrice(price) {
  var num = parseFloat(price)
  if (isNaN(num) || num <= 0) {
    return 0
  }
  return num
}

function formatPrice(price) {
  if (price === null || price === undefined || price === '') {
    return '0.00'
  }
  var num = parseFloat(price)
  if (isNaN(num)) {
    return '0.00'
  }
  return num.toFixed(2)
}

function formatTagOptionPrice(price) {
  var num = normalizePrice(price)
  if (!num) {
    return ''
  }
  return '+' + num.toFixed(2) + '元'
}

function formatAbsOptionPrice(price) {
  var num = parseFloat(price)
  if (isNaN(num) || num <= 0) {
    return ''
  }
  if (num === parseInt(num, 10)) {
    return num + '元'
  }
  return num.toFixed(2) + '元'
}

function formatTagLabelSuffix(price) {
  var num = normalizePrice(price)
  if (!num) {
    return ''
  }
  return ' +' + num.toFixed(2) + '元'
}

module.exports = {
  normalizePrice: normalizePrice,
  formatPrice: formatPrice,
  formatTagOptionPrice: formatTagOptionPrice,
  formatAbsOptionPrice: formatAbsOptionPrice,
  formatTagLabelSuffix: formatTagLabelSuffix
}

