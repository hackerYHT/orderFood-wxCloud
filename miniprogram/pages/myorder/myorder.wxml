<!--pages/myorder/myorder.wxml-->
<view class="page">
  <view class="page-header">
    <text class="page-title">打印订单记录</text>
    <text class="page-subtitle">店员口头点餐提交后自动生成</text>
  </view>

  <view class="order-list">
    <view class="order-item" wx:for="{{orderList}}" wx:key="_id">
      <view class="order-header">
        <view class="order-type">
          <text wx:if="{{item.orderType === 'dineIn'}}">🍽️ 堂食订单</text>
          <text wx:elif="{{item.orderType === 'takeOut'}}">📦 打包订单</text>
          <text wx:else>🍽️ 点餐订单</text>
        </view>
        <view class="print-status" wx:if="{{item.printStatus === 2}}">已打印</view>
        <view class="print-status pending" wx:elif="{{item.printStatus}}">打印异常</view>
      </view>

      <view class="order-content">
        <view class="goods-list">
          <view class="goods-item" wx:for="{{item.goods}}" wx:for-item="goods" wx:key="goodsId">
            <image class="goods-image" src="{{goods.dishImage}}" mode="aspectFill"></image>
            <view class="goods-info">
              <view class="goods-name">{{goods.dishName}}</view>
              <view class="goods-tags" wx:if="{{goods.tags && goods.tags.length > 0}}">
                <van-tag type="danger" wx:for="{{goods.tags}}" wx:key="index" wx:for-item="tagVal">{{tagVal}}</van-tag>
              </view>
              <view class="goods-detail">
                <text class="goods-price">¥{{goods.price}}</text>
                <text class="goods-count">x{{goods.count}}</text>
              </view>
            </view>
          </view>
        </view>

        <view class="order-remark" wx:if="{{item.remark}}">
          备注：{{item.remark}}
        </view>
      </view>

      <view class="order-footer">
        <view class="order-info">
          <view class="order-time">{{item.createTimeText}}</view>
          <view class="order-table-code" wx:if="{{item.tableNumber}}">桌号：{{item.tableNumber}}</view>
        </view>
        <view class="order-actions">
          <view class="order-price">
            <text class="price-label">合计：</text>
            <text class="price-num">¥{{item.finalPrice}}</text>
          </view>
        </view>
      </view>
    </view>

    <van-empty wx:if="{{orderList.length === 0}}" description="暂无订单" />
  </view>
</view>
