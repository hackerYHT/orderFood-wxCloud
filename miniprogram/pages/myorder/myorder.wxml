<!--pages/myorder/myorder.wxml-->
<view class="page">
  <view class="page-header">
    <text class="page-title">打印订单记录</text>
    <text class="page-subtitle">店员口头点餐提交后自动生成 · 点 ○/✓ 标记出餐</text>
  </view>

  <view class="tabs">
    <view
      class="tab-item {{payFilter === index ? 'active' : ''}}"
      wx:for="{{payFilterOptions}}"
      wx:key="index"
      data-index="{{index}}"
      bindtap="onPayFilterChange"
    >
      <text class="tab-text">{{item}}</text>
      <view class="tab-line" wx:if="{{payFilter === index}}"></view>
    </view>
  </view>

  <view class="order-list">
    <view class="date-group" wx:for="{{orderGroups}}" wx:key="dateKey" wx:for-item="group">
      <view
        class="date-header {{group.isToday ? 'today' : ''}} {{group.expanded ? 'expanded' : ''}}"
        data-key="{{group.dateKey}}"
        bindtap="toggleDateGroup"
      >
        <view class="date-header-left">
          <text class="date-arrow">{{group.expanded ? '▼' : '▶'}}</text>
          <text class="date-label">{{group.dateLabel}}</text>
          <text class="date-count">{{group.count}}单</text>
        </view>
        <text class="date-toggle-tip">{{group.expanded ? '收起' : '展开'}}</text>
      </view>

      <view class="date-orders" wx:if="{{group.expanded}}">
        <view class="order-item" wx:for="{{group.orders}}" wx:key="_id" wx:for-item="item">
          <view class="order-header">
            <view class="order-type">
              <text class="queue-number" wx:if="{{item.queueNumber}}">#{{item.queueNumber}}</text>
              <text wx:if="{{item.orderType === 'dineIn'}}">🍽️ 堂食订单</text>
              <text wx:elif="{{item.orderType === 'takeOut'}}">📦 打包订单</text>
              <text wx:else>🍽️ 点餐订单</text>
            </view>
            <view class="order-status-row">
              <view class="pay-status {{item.pay_status ? 'paid' : 'unpaid'}}">
                {{item.pay_status ? '已支付' : '未支付'}}
              </view>
              <view class="print-status" wx:if="{{item.printStatus === 2}}">已打印</view>
              <view class="print-status pending" wx:elif="{{item.printStatus}}">打印异常</view>
            </view>
          </view>

          <view class="order-content">
            <view class="serve-toolbar" wx:if="{{item.goods && item.goods.length > 0}}">
              <text class="serve-progress">出餐 {{item.servedCount || 0}}/{{item.goods.length}}</text>
              <view
                class="serve-all-btn {{item.allServed ? 'on' : ''}}"
                data-order-id="{{item._id}}"
                data-all="{{item.allServed}}"
                catchtap="markAllGoodsServed"
              >
                {{item.allServed ? '✓ 取消全出' : '✓ 全部出餐'}}
              </view>
            </view>
            <view class="goods-list">
              <view
                class="goods-item {{goods.served ? 'served' : ''}}"
                wx:for="{{item.goods}}"
                wx:for-item="goods"
                wx:for-index="goodsIndex"
                wx:key="goodsIndex"
              >
                <view
                  class="serve-mark {{goods.served ? 'on' : 'off'}}"
                  data-order-id="{{item._id}}"
                  data-index="{{goodsIndex}}"
                  catchtap="toggleGoodsServed"
                >
                  <text class="serve-symbol">{{goods.served ? '✓' : '○'}}</text>
                </view>
                <image class="goods-image" src="{{goods.dishImage}}" mode="aspectFill"></image>
                <view class="goods-info">
                  <view class="goods-name-row">
                    <text class="goods-name">{{goods.dishName}}</text>
                    <text class="serve-label {{goods.served ? 'on' : ''}}">{{goods.served ? '已出餐' : '未出餐'}}</text>
                  </view>
                  <view class="goods-tags" wx:if="{{goods.tags && goods.tags.length > 0}}">
                    <van-tag type="danger" wx:for="{{goods.tags}}" wx:key="index" wx:for-item="tagVal">{{tagVal}}</van-tag>
                  </view>
                  <view class="goods-detail">
                    <text class="goods-price">¥{{goods.price}}</text>
                    <text class="goods-count">x{{goods.count}}</text>
                  </view>
                </view>
              </view>
            </view>

            <view class="order-remark" wx:if="{{item.remark}}">
              备注：{{item.remark}}
            </view>
          </view>

          <view class="order-footer">
            <view class="order-info">
              <view class="order-time">{{item.createTimeText}}</view>
              <view class="order-table-code" wx:if="{{item.tableNumber}}">桌号：{{item.tableNumber}}</view>
            </view>
            <view class="order-actions">
              <view
                class="action-btn edit"
                data-id="{{item._id}}"
                catchtap="goEditOrder"
              >
                编辑
              </view>
              <view
                class="action-btn pay-toggle {{item.pay_status ? 'paid' : 'unpaid'}}"
                data-id="{{item._id}}"
                data-status="{{item.pay_status}}"
                catchtap="togglePayStatus"
              >
                {{item.pay_status ? '改为未支付' : '改为已支付'}}
              </view>
              <view
                class="action-btn delete"
                data-id="{{item._id}}"
                data-queue="{{item.queueNumber}}"
                catchtap="deleteOrder"
              >
                删除
              </view>
              <view class="order-price">
                <text class="price-label">合计：</text>
                <text class="price-num">¥{{item.finalPrice}}</text>
              </view>
            </view>
          </view>
        </view>
      </view>
    </view>

    <van-empty wx:if="{{orderGroups.length === 0}}" description="暂无订单" />
  </view>
</view>
