<!--pages/myhome/myhome.wxml-->
<view class="page">
  <view class="user-header">
    <view class="user-main">
      <view class="user-avatar">
        <image src="/images/tabBar/me.png" mode="aspectFill"></image>
      </view>
      <view class="user-detail">
        <view class="user-name">{{shopInfo.name || '店员点餐打印'}}</view>
        <view class="user-phone">店员专用 · 口头点餐打印小票</view>
      </view>
    </view>
  </view>

  <view class="menu-section">
    <view class="menu-item" bindtap="goToPrinterDoc">
      <text class="menu-icon">🖨️</text>
      <text class="menu-text">打印机配置说明</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item tips-item">
      <text class="menu-icon">💡</text>
      <view class="menu-text-block">
        <text class="menu-text">进入管理后台</text>
        <text class="menu-desc">在本页右下角空白处连续点击 5 次</text>
      </view>
    </view>
  </view>

  <view class="admin-trigger" bindtap="onAdminTrigger"></view>

  <view class="modal-mask" wx:if="{{showPasswordModal}}" catchtap="noop">
    <view class="modal-dialog" catchtap="stopPropagation">
      <view class="modal-title">{{isFirstTime ? '设置管理员密码' : '管理员登录'}}</view>
      <view class="modal-content">
        <input
          class="password-input"
          type="password"
          placeholder="{{isFirstTime ? '请设置管理员密码（至少6位）' : '请输入管理员密码'}}"
          value="{{adminPassword}}"
          bindinput="onPasswordInput" />
        <view class="password-hint" wx:if="{{isFirstTime}}">
          首次设置，请设置一个安全的密码
        </view>
      </view>
      <view class="modal-footer">
        <view class="modal-btn cancel" bindtap="closePasswordModal">取消</view>
        <view class="modal-btn confirm" bindtap="verifyPassword">{{isFirstTime ? '设置' : '登录'}}</view>
      </view>
    </view>
  </view>

  <view class="version-info">
    <text class="version-text">版本号：{{version}}</text>
  </view>
</view>
