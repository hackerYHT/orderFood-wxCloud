/* pages/admin/tagBatch/tagBatch.wxss */
.page {
  min-height: 100vh;
  background: #f5f5f5;
  padding: 20rpx;
  padding-bottom: 180rpx;
  box-sizing: border-box;
}

.tab-bar {
  display: flex;
  background: white;
  border-radius: 16rpx;
  overflow: hidden;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 24rpx 10rpx;
  font-size: 26rpx;
  color: #666;
}

.tab-item.active {
  color: #e54d42;
  font-weight: bold;
  background: #fff5f5;
}

.filter-bar {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.filter-picker,
.select-all-btn {
  background: white;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  font-size: 26rpx;
  color: #333;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.filter-picker {
  flex: 1;
}

.select-all-btn {
  color: #e54d42;
  white-space: nowrap;
}

.dish-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.dish-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  background: white;
  border-radius: 16rpx;
  padding: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
  border: 2rpx solid transparent;
}

.dish-row.selected {
  border-color: #e54d42;
  background: #fffafa;
}

.dish-checkbox {
  width: 40rpx;
  height: 40rpx;
  border: 2rpx solid #ddd;
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: white;
  font-size: 24rpx;
  flex-shrink: 0;
}

.dish-checkbox.checked {
  background: #e54d42;
  border-color: #e54d42;
}

.dish-main {
  flex: 1;
  min-width: 0;
}

.dish-name {
  font-size: 30rpx;
  color: #333;
  font-weight: bold;
  margin-bottom: 8rpx;
}

.dish-meta {
  font-size: 22rpx;
  color: #999;
}

.selection-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: white;
  padding: 20rpx 24rpx calc(20rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.08);
  z-index: 100;
}

.selection-info {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 26rpx;
  color: #333;
  margin-bottom: 16rpx;
}

.clear-link {
  color: #e54d42;
}

.selection-actions {
  display: flex;
  gap: 16rpx;
}

.action-btn {
  flex: 1;
  text-align: center;
  padding: 22rpx 0;
  border-radius: 12rpx;
  font-size: 28rpx;
}

.action-btn.primary {
  background: linear-gradient(135deg, #e54d42 0%, #f37370 100%);
  color: white;
}

.action-btn.outline {
  background: white;
  color: #e54d42;
  border: 2rpx solid #e54d42;
}

.tag-stat-title-wrap {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex: 1;
  min-width: 0;
}

.tag-badge {
  font-size: 20rpx;
  color: #1890ff;
  background: #e6f7ff;
  padding: 4rpx 10rpx;
  border-radius: 8rpx;
  flex-shrink: 0;
}

.form-input,
.picker-input {
  width: 100%;
  min-height: 80rpx;
  padding: 0 24rpx;
  border: 2rpx solid #e5e5e5;
  border-radius: 10rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  font-size: 28rpx;
  color: #333;
}

.remove-tag-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.remove-tag-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx;
  background: #f9f9f9;
  border-radius: 12rpx;
  border: 2rpx solid transparent;
}

.remove-tag-item.active {
  border-color: #e54d42;
  background: #fff5f5;
}

.remove-tag-name {
  font-size: 28rpx;
  color: #333;
}

.remove-tag-count {
  font-size: 22rpx;
  color: #999;
}

.tip-bar {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  background: #fff7e6;
  border-radius: 16rpx;
  border: 2rpx solid #ffe7ba;
}

.tip-icon {
  font-size: 28rpx;
  line-height: 1.5;
}

.tip-text {
  flex: 1;
  font-size: 26rpx;
  color: #ad6800;
  line-height: 1.5;
}

.loading-tip {
  padding: 80rpx 0;
  text-align: center;
  color: #999;
  font-size: 28rpx;
}

.tag-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.tag-stat-card {
  background: white;
  border-radius: 20rpx;
  padding: 28rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.tag-stat-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.tag-stat-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.tag-stat-count {
  font-size: 24rpx;
  color: #e54d42;
  background: #fff5f5;
  padding: 6rpx 14rpx;
  border-radius: 20rpx;
}

.tag-stat-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.meta-item {
  font-size: 22rpx;
  color: #666;
  background: #f5f5f5;
  padding: 6rpx 12rpx;
  border-radius: 8rpx;
}

.tag-stat-action {
  font-size: 24rpx;
  color: #e54d42;
  text-align: right;
}

/* 弹窗 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.6);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 9999;
}

.modal-dialog {
  width: 680rpx;
  max-height: 85vh;
  background: white;
  border-radius: 20rpx;
  overflow: hidden;
  display: flex;
  flex-direction: column;
}

.modal-title {
  padding: 36rpx 30rpx 20rpx;
  text-align: center;
  font-size: 34rpx;
  font-weight: bold;
  color: #333;
  flex-shrink: 0;
}

.modal-content {
  flex: 1;
  min-height: 0;
  max-height: 60vh;
  padding: 10rpx 30rpx 30rpx;
  box-sizing: border-box;
}

.form-item {
  margin-bottom: 28rpx;
}

.form-label {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 15rpx;
}

.affected-summary {
  font-size: 26rpx;
  color: #e54d42;
  margin-bottom: 12rpx;
}

.affected-list {
  max-height: 200rpx;
  overflow-y: auto;
  background: #f9f9f9;
  border-radius: 12rpx;
  padding: 12rpx 16rpx;
}

.affected-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 10rpx 0;
  border-bottom: 2rpx solid #f0f0f0;
}

.affected-item:last-child {
  border-bottom: none;
}

.affected-dish-name {
  font-size: 26rpx;
  color: #333;
}

.affected-category {
  font-size: 22rpx;
  color: #999;
}

.required-quick-actions {
  display: flex;
  gap: 15rpx;
  margin-bottom: 15rpx;
}

.quick-btn {
  flex: 1;
  padding: 16rpx;
  text-align: center;
  font-size: 24rpx;
  border-radius: 8rpx;
  background: linear-gradient(135deg, #e54d42 0%, #f37370 100%);
  color: white;
}

.quick-btn.outline {
  background: white;
  color: #e54d42;
  border: 2rpx solid #e54d42;
}

.quick-btn.active {
  opacity: 1;
}

.quick-btn.outline.active {
  background: #fff5f5;
}

.type-selector {
  display: flex;
  gap: 20rpx;
}

.type-option {
  flex: 1;
  height: 80rpx;
  border: 2rpx solid #e5e5e5;
  border-radius: 10rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: #666;
  background: white;
}

.type-option.active {
  border-color: #e54d42;
  background: linear-gradient(135deg, #e54d42 0%, #f37370 100%);
  color: white;
  font-weight: bold;
}

.form-note {
  font-size: 22rpx;
  color: #999;
  line-height: 1.6;
  padding: 16rpx;
  background: #fafafa;
  border-radius: 10rpx;
}

.modal-footer {
  display: flex;
  border-top: 2rpx solid #e5e5e5;
  flex-shrink: 0;
}

.modal-btn {
  flex: 1;
  height: 100rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
}

.modal-btn.cancel {
  color: #666;
  border-right: 2rpx solid #e5e5e5;
}

.modal-btn.confirm {
  color: #e54d42;
  font-weight: bold;
}
