/* pages/admin/stats/stats.wxss */
.page {
  min-height: 100vh;
  background: #f5f5f5;
  padding: 20rpx;
  padding-bottom: 40rpx;
  box-sizing: border-box;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}

.range-section,
.summary-section,
.type-section,
.dish-section {
  background: white;
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
}

.range-tabs {
  display: flex;
  gap: 16rpx;
  flex-wrap: wrap;
}

.range-tab {
  padding: 16rpx 28rpx;
  border-radius: 999rpx;
  background: #f5f5f5;
  color: #666;
  font-size: 28rpx;
}

.range-tab.active {
  background: #e54d42;
  color: white;
  font-weight: bold;
}

.custom-range {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 24rpx;
}

.date-picker {
  flex: 1;
  background: #f8f8f8;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
}

.date-label {
  display: block;
  font-size: 22rpx;
  color: #999;
  margin-bottom: 8rpx;
}

.date-value {
  font-size: 28rpx;
  color: #333;
}

.date-sep {
  color: #999;
  font-size: 26rpx;
}

.range-hint {
  margin-top: 20rpx;
  font-size: 24rpx;
  color: #999;
}

.summary-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
}

.summary-card {
  background: #f8f8f8;
  border-radius: 16rpx;
  padding: 28rpx 24rpx;
}

.summary-card.primary {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
}

.summary-card.primary .card-value,
.summary-card.primary .card-label {
  color: white;
}

.summary-card.success {
  background: #e8f5e9;
}

.summary-card.warning {
  background: #fff3e0;
}

.card-value {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  line-height: 1.3;
  word-break: break-all;
}

.card-label {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #666;
}

.summary-card.success .card-value {
  color: #2e7d32;
}

.summary-card.warning .card-value {
  color: #ef6c00;
}

.type-grid {
  display: flex;
  gap: 20rpx;
}

.type-card {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 20rpx;
  background: #f8f8f8;
  border-radius: 16rpx;
  padding: 28rpx 24rpx;
}

.type-icon {
  font-size: 48rpx;
}

.type-count {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
}

.type-amount {
  margin-top: 8rpx;
  font-size: 26rpx;
  color: #e54d42;
}

.dish-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.dish-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 20rpx 0;
  border-bottom: 2rpx solid #f0f0f0;
}

.dish-item:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.dish-rank {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: #eee;
  color: #666;
  font-size: 24rpx;
  font-weight: bold;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.dish-rank.rank-1 {
  background: #ffd700;
  color: #8b6914;
}

.dish-rank.rank-2 {
  background: #c0c0c0;
  color: #555;
}

.dish-rank.rank-3 {
  background: #cd7f32;
  color: white;
}

.dish-main {
  flex: 1;
  min-width: 0;
}

.dish-name {
  font-size: 30rpx;
  color: #333;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.dish-meta {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #999;
}

.dish-count {
  font-size: 32rpx;
  font-weight: bold;
  color: #e54d42;
  flex-shrink: 0;
}
