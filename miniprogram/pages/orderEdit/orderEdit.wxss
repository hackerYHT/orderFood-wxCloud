/* pages/orderEdit/orderEdit.wxss */
.page {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: 140rpx;
}

.notice-bar {
  background: #fff8f0;
  color: #ff976a;
  font-size: 24rpx;
  padding: 20rpx 30rpx;
  border-bottom: 1rpx solid #ffe8d6;
}

.queue-banner {
  padding: 24rpx 30rpx;
  font-size: 32rpx;
  font-weight: bold;
  color: #e54d42;
  background: white;
}

.section {
  background: white;
  margin-top: 20rpx;
  padding: 30rpx 0;
}

.section:first-of-type {
  margin-top: 0;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  padding: 0 30rpx;
  margin-bottom: 20rpx;
}

.section-title-wrapper {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 30rpx;
  margin-bottom: 20rpx;
}

.section-title-wrapper .section-title {
  padding: 0;
  margin-bottom: 0;
}

.add-dish-btn {
  padding: 8rpx 24rpx;
  font-size: 26rpx;
  color: #07c160;
  border: 2rpx solid #07c160;
  border-radius: 8rpx;
  background: white;
}

.order-type-list {
  display: flex;
  gap: 20rpx;
  padding: 0 30rpx;
}

.order-type-item {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  font-size: 28rpx;
  color: #666;
  background: #f8f8f8;
  border-radius: 12rpx;
  border: 2rpx solid transparent;
}

.order-type-item.active {
  color: #e54d42;
  background: rgba(229, 77, 66, 0.08);
  border-color: #e54d42;
  font-weight: 600;
}

.table-number-wrapper {
  padding: 0 30rpx;
}

.table-number-picker {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 80rpx;
  padding: 0 28rpx;
  font-size: 28rpx;
  background: #f8f8f8;
  border-radius: 12rpx;
  border: 2rpx solid #eee;
  box-sizing: border-box;
}

.table-number-text {
  color: #333;
}

.table-number-text.placeholder {
  color: #999;
}

.table-number-arrow {
  color: #ccc;
  font-size: 36rpx;
  line-height: 1;
}

.remark-wrapper {
  padding: 0 30rpx;
}

.remark-input {
  width: 100%;
  min-height: 120rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  background: #f8f8f8;
  border-radius: 12rpx;
  border: 2rpx solid #eee;
  box-sizing: border-box;
}

.goods-list {
  padding: 0 30rpx;
}

.goods-item {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.goods-item:last-child {
  border-bottom: none;
}

.goods-image {
  width: 100rpx;
  height: 100rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
}

.goods-info {
  flex: 1;
  margin: 0 16rpx;
  min-width: 0;
}

.goods-name {
  font-size: 28rpx;
  color: #333;
  margin-bottom: 8rpx;
}

.goods-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-bottom: 8rpx;
}

.goods-price-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.goods-price {
  font-size: 26rpx;
  color: #e54d42;
}

.goods-subtotal {
  font-size: 24rpx;
  color: #999;
}

.goods-edit-actions {
  display: flex;
  align-items: center;
  gap: 8rpx;
  flex-shrink: 0;
}

.qty-btn {
  width: 48rpx;
  height: 48rpx;
  line-height: 48rpx;
  text-align: center;
  background: #f5f5f5;
  border-radius: 50%;
  font-size: 32rpx;
  color: #333;
}

.qty-num {
  min-width: 36rpx;
  text-align: center;
  font-size: 28rpx;
  color: #333;
}

.delete-btn {
  margin-left: 8rpx;
  padding: 8rpx 16rpx;
  font-size: 22rpx;
  color: #e54d42;
  background: rgba(229, 77, 66, 0.1);
  border-radius: 8rpx;
}

.price-info {
  margin-top: 20rpx;
  padding: 20rpx 30rpx 0;
  border-top: 1rpx solid #f5f5f5;
}

.price-item {
  display: flex;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.price-label {
  font-size: 26rpx;
  color: #666;
}

.price-value {
  font-size: 26rpx;
  color: #333;
}

.footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 30rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: white;
  border-top: 1rpx solid #f0f0f0;
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.05);
}

.footer-price {
  display: flex;
  align-items: baseline;
}

.footer-label {
  font-size: 28rpx;
  color: #666;
}

.footer-price-num {
  font-size: 40rpx;
  color: #e54d42;
  font-weight: bold;
}

.save-btn {
  padding: 20rpx 48rpx;
  background: #e54d42;
  color: white;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 50rpx;
}

.save-btn.disabled {
  opacity: 0.5;
}
