/* pages/orderEdit/orderEdit.wxss */
.page {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: 140rpx;
}

.notice-bar {
  background: #fff8f0;
  color: #ff976a;
  font-size: 24rpx;
  padding: 20rpx 30rpx;
  border-bottom: 1rpx solid #ffe8d6;
}

.queue-banner {
  padding: 24rpx 30rpx;
  font-size: 32rpx;
  font-weight: bold;
  color: #e54d42;
  background: white;
}

.section {
  background: white;
  margin-top: 20rpx;
  padding: 30rpx 0;
}

.section:first-of-type {
  margin-top: 0;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  padding: 0 30rpx;
  margin-bottom: 20rpx;
}

.section-title-wrapper {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 30rpx;
  margin-bottom: 20rpx;
}

.section-title-wrapper .section-title {
  padding: 0;
  margin-bottom: 0;
}

.add-dish-btn {
  padding: 8rpx 24rpx;
  font-size: 26rpx;
  color: #07c160;
  border: 2rpx solid #07c160;
  border-radius: 8rpx;
  background: white;
}

.order-type-list {
  display: flex;
  gap: 20rpx;
  padding: 0 30rpx;
}

.order-type-item {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  font-size: 28rpx;
  color: #666;
  background: #f8f8f8;
  border-radius: 12rpx;
  border: 2rpx solid transparent;
}

.order-type-item.active {
  color: #e54d42;
  background: rgba(229, 77, 66, 0.08);
  border-color: #e54d42;
  font-weight: 600;
}

.section-tip {
  margin-top: 16rpx;
  padding: 0 30rpx;
  font-size: 22rpx;
  color: #999;
  line-height: 1.4;
}

.pack-toggle {
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
  margin-top: 10rpx;
  padding: 6rpx 14rpx;
  font-size: 22rpx;
  color: #666;
  background: #f5f5f5;
  border-radius: 8rpx;
  border: 2rpx solid transparent;
}

.pack-toggle.active {
  color: #e54d42;
  background: rgba(229, 77, 66, 0.08);
  border-color: #e54d42;
}

.pack-check {
  width: 28rpx;
  height: 28rpx;
  border-radius: 6rpx;
  border: 2rpx solid #ccc;
  box-sizing: border-box;
  background: #fff;
  position: relative;
  flex-shrink: 0;
}

.pack-check.checked {
  border-color: #e54d42;
  background: #e54d42;
}

.pack-check.checked::after {
  content: '';
  position: absolute;
  left: 8rpx;
  top: 2rpx;
  width: 8rpx;
  height: 14rpx;
  border: 2rpx solid #fff;
  border-top: 0;
  border-left: 0;
  transform: rotate(45deg);
}

.table-number-wrapper {
  padding: 0 30rpx;
}

.table-number-picker {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 80rpx;
  padding: 0 28rpx;
  font-size: 28rpx;
  background: #f8f8f8;
  border-radius: 12rpx;
  border: 2rpx solid #eee;
  box-sizing: border-box;
}

.table-number-text {
  color: #333;
}

.table-number-text.placeholder {
  color: #999;
}

.table-number-arrow {
  color: #ccc;
  font-size: 36rpx;
  line-height: 1;
}

.remark-wrapper {
  padding: 0 30rpx;
}

.remark-input {
  width: 100%;
  min-height: 120rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  background: #f8f8f8;
  border-radius: 12rpx;
  border: 2rpx solid #eee;
  box-sizing: border-box;
}

.goods-list {
  padding: 0 30rpx;
}

.goods-item {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.goods-item:last-child {
  border-bottom: none;
}

.goods-image {
  width: 100rpx;
  height: 100rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
}

.goods-info {
  flex: 1;
  margin: 0 16rpx;
  min-width: 0;
}

.goods-name {
  font-size: 28rpx;
  color: #333;
  margin-bottom: 8rpx;
}

.goods-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-bottom: 8rpx;
}

.goods-price-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.goods-price {
  font-size: 26rpx;
  color: #e54d42;
}

.goods-subtotal {
  font-size: 24rpx;
  color: #999;
}

.goods-edit-actions {
  display: flex;
  align-items: center;
  gap: 8rpx;
  flex-shrink: 0;
  flex-wrap: wrap;
  justify-content: flex-end;
  max-width: 280rpx;
}

.goods-edit-btn {
  padding: 10rpx 18rpx;
  font-size: 24rpx;
  color: #38b2ac;
  background: rgba(56, 178, 172, 0.12);
  border-radius: 8rpx;
  line-height: 1.2;
}

.qty-btn {
  width: 48rpx;
  height: 48rpx;
  line-height: 48rpx;
  text-align: center;
  background: #f5f5f5;
  border-radius: 50%;
  font-size: 32rpx;
  color: #333;
}

.qty-num {
  min-width: 36rpx;
  text-align: center;
  font-size: 28rpx;
  color: #333;
}

.delete-btn {
  margin-left: 8rpx;
  padding: 8rpx 16rpx;
  font-size: 22rpx;
  color: #e54d42;
  background: rgba(229, 77, 66, 0.1);
  border-radius: 8rpx;
}

.price-info {
  margin-top: 20rpx;
  padding: 20rpx 30rpx 0;
  border-top: 1rpx solid #f5f5f5;
}

.price-item {
  display: flex;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.price-label {
  font-size: 26rpx;
  color: #666;
}

.price-value {
  font-size: 26rpx;
  color: #333;
}

.footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 30rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: white;
  border-top: 1rpx solid #f0f0f0;
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.05);
}

.footer-price {
  display: flex;
  align-items: baseline;
}

.footer-label {
  font-size: 28rpx;
  color: #666;
}

.footer-price-num {
  font-size: 40rpx;
  color: #e54d42;
  font-weight: bold;
}

.save-btn {
  padding: 20rpx 48rpx;
  background: #e54d42;
  color: white;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 50rpx;
}

.save-btn.disabled {
  opacity: 0.5;
}
/* 规格编辑弹窗（与点餐页一致） */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.6);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 9999;
}

.modal-dialog.dish-detail-modal {
  width: 90%;
  max-height: 85vh;
  background: white;
  border-radius: 24rpx;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  position: relative;
}

.modal-close {
  position: absolute;
  top: 20rpx;
  left: 20rpx;
  width: 60rpx;
  height: 60rpx;
  background: rgba(0, 0, 0, 0.3);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: white;
  font-size: 48rpx;
  font-weight: 300;
  z-index: 10;
  line-height: 1;
}

.modal-content {
  flex: 1;
  overflow-y: auto;
  padding: 30rpx;
  max-height: 65vh;
  box-sizing: border-box;
}

.dish-detail-header {
  margin-bottom: 30rpx;
}

.dish-detail-image {
  width: 100%;
  height: 320rpx;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
  background: #f5f5f5;
}

.dish-detail-info {
  padding: 0 10rpx;
}

.dish-detail-name {
  font-size: 36rpx;
  color: #333;
  font-weight: bold;
  margin-bottom: 15rpx;
}

.dish-detail-desc {
  font-size: 26rpx;
  color: #999;
  line-height: 1.6;
  margin-bottom: 15rpx;
}

.dish-detail-price {
  font-size: 40rpx;
  color: #e54d42;
  font-weight: bold;
}

.dish-detail-price .price-symbol {
  font-size: 28rpx;
}

.tag-section {
  margin-bottom: 30rpx;
  padding: 25rpx;
  background: #f9f9f9;
  border-radius: 16rpx;
}

.tag-title {
  font-size: 28rpx;
  color: #333;
  margin-bottom: 20rpx;
  font-weight: bold;
  display: flex;
  align-items: center;
}

.tag-type-label {
  font-size: 22rpx;
  color: #999;
  font-weight: normal;
  margin-left: 8rpx;
}

.tag-required-label {
  font-size: 22rpx;
  color: white;
  background: #e54d42;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
  margin-left: 10rpx;
  font-weight: normal;
}

.tag-options {
  display: flex;
  flex-wrap: wrap;
  gap: 15rpx;
}

.tag-option {
  padding: 16rpx 20rpx 16rpx 30rpx;
  background: white;
  border: 2rpx solid #e5e5e5;
  border-radius: 12rpx;
  font-size: 26rpx;
  color: #666;
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.tag-option-main {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.tag-option-count {
  font-size: 22rpx;
  font-weight: bold;
  opacity: 0.9;
}

.tag-option-reduce {
  width: 44rpx;
  height: 44rpx;
  margin-left: 4rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.25);
  color: white;
  font-size: 32rpx;
  line-height: 40rpx;
  text-align: center;
  flex-shrink: 0;
}

.tag-option:not(.selected) .tag-option-reduce {
  background: #f5f5f5;
  color: #999;
}

.tag-option-price {
  color: #e54d42;
}

.tag-option.selected {
  background: linear-gradient(135deg, #e54d42 0%, #f37370 100%);
  border-color: #e54d42;
  color: white;
  font-weight: bold;
}

.tag-option.selected .tag-option-price {
  color: white;
}

.quantity-section {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 25rpx;
  background: #f9f9f9;
  border-radius: 16rpx;
  margin-top: 10rpx;
}

.quantity-label {
  font-size: 28rpx;
  color: #333;
  font-weight: bold;
}

.quantity-controls {
  display: flex;
  align-items: center;
  gap: 30rpx;
}

.quantity-btn {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #e54d42 0%, #f37370 100%);
  color: white;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  font-weight: bold;
}

.quantity-btn.disabled {
  background: #e5e5e5;
  color: #999;
}

.quantity-num {
  font-size: 32rpx;
  color: #333;
  font-weight: bold;
  min-width: 60rpx;
  text-align: center;
}

.modal-footer-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 30rpx;
  background: white;
  border-top: 2rpx solid #f5f5f5;
  flex-shrink: 0;
  gap: 16rpx;
}

.modal-footer-bar .footer-price {
  display: flex;
  align-items: baseline;
  flex-shrink: 0;
}

.total-label {
  font-size: 26rpx;
  color: #666;
  margin-right: 10rpx;
}

.modal-footer-bar .price-symbol {
  font-size: 26rpx;
  color: #e54d42;
  font-weight: bold;
}

.modal-footer-bar .price-num {
  font-size: 40rpx;
  color: #e54d42;
  font-weight: bold;
}

.modal-footer-actions {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.modal-delete-btn {
  padding: 18rpx 28rpx;
  font-size: 28rpx;
  color: #e54d42;
  background: rgba(229, 77, 66, 0.1);
  border-radius: 40rpx;
  font-weight: 600;
}

.add-cart-btn {
  padding: 18rpx 36rpx;
  background: linear-gradient(135deg, #e54d42 0%, #f37370 100%);
  color: white;
  border-radius: 40rpx;
  font-size: 28rpx;
  font-weight: bold;
}
