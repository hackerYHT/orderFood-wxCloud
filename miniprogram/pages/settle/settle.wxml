<!--pages/settle/settle.wxml-->
<wxs module="priceHelper" src="../../utils/priceHelper.wxs"></wxs>
<view class="page">
  <scroll-view class="page-scroll" scroll-y enhanced show-scrollbar="{{false}}">
  <view class="page-content">
  <view class="section">
    <view class="section-title">订单类型</view>
    <view class="order-type-list">
      <view
        class="order-type-item {{orderType === 'dineIn' ? 'active' : ''}}"
        data-value="dineIn"
        bind:tap="selectOrderType">
        堂食
      </view>
      <view
        class="order-type-item {{orderType === 'takeOut' ? 'active' : ''}}"
        data-value="takeOut"
        bind:tap="selectOrderType">
        打包
      </view>
    </view>
    <view class="section-tip">整单快捷勾选；混单可在下方菜品单独勾选「打包」</view>
  </view>

  <view class="section">
    <view class="section-title">桌号（选填）</view>
    <view class="table-number-wrapper">
      <picker
        mode="selector"
        range="{{tablePickerOptions}}"
        value="{{tablePickerIndex}}"
        bindchange="onTableNumberChange">
        <view class="table-number-picker">
          <text class="table-number-text {{tableNumber ? '' : 'placeholder'}}">{{tableNumber || '请选择桌号'}}</text>
          <text class="table-number-arrow">›</text>
        </view>
      </picker>
    </view>
  </view>

  <view class="section">
    <view class="section-title">是否支付</view>
    <view class="order-type-list">
      <view
        class="order-type-item {{!payStatus ? 'active' : ''}}"
        data-value="false"
        bind:tap="selectPayStatus">
        未支付
      </view>
      <view
        class="order-type-item {{payStatus ? 'active' : ''}}"
        data-value="true"
        bind:tap="selectPayStatus">
        已支付
      </view>
    </view>
  </view>

  <view class="section">
    <view class="section-title">备注（选填）</view>
    <view class="remark-wrapper">
      <textarea
        class="remark-input"
        placeholder="可填写顾客要求，如：少辣、不要香菜"
        value="{{remark}}"
        bindinput="onRemarkInput"
        maxlength="100"
        auto-height />
    </view>
  </view>

  <view class="section">
    <view class="section-title">订单明细</view>
    <view class="goods-list">
      <view class="goods-item" wx:for="{{orderGoods}}" wx:key="index">
        <image class="goods-image" src="{{item.dishImage}}" mode="aspectFill"></image>
        <view class="goods-info">
          <view class="goods-name">{{item.dishName}}</view>
          <view class="goods-tags" wx:if="{{item.tags && item.tags.length > 0}}">
            <van-tag
              type="danger"
              wx:for="{{item.tags}}"
              wx:key="index"
              wx:for-item="tagVal">
              {{tagVal}}
            </van-tag>
          </view>
          <view class="goods-price-count">
            <text class="goods-price">¥{{item.price}}</text>
            <text class="goods-count">×{{item.count}}</text>
          </view>
          <view
            wx:if="{{item.packagingFeeEligible}}"
            class="pack-toggle {{item.needPackaging ? 'active' : ''}}"
            data-index="{{index}}"
            catch:tap="toggleGoodsPackaging">
            <view class="pack-check {{item.needPackaging ? 'checked' : ''}}"></view>
            <text>打包 +¥1/件</text>
          </view>
        </view>
        <view class="goods-right">
          <view class="goods-edit-btn" catch:tap="openEditGoods" data-index="{{index}}">编辑</view>
          <view class="goods-subtotal">¥{{item.subtotal}}</view>
        </view>
      </view>

      <van-empty wx:if="{{orderGoods.length === 0}}" description="购物车为空" />
    </view>

    <view class="price-info" wx:if="{{orderGoods.length > 0}}">
      <view class="price-item">
        <text class="price-label">商品小计</text>
        <text class="price-value">¥{{priceHelper.formatPrice(totalPrice)}}</text>
      </view>
      <view class="price-item" wx:if="{{packagingFeeItemCount > 0}}">
        <text class="price-label">打包费（{{packagingFeeItemCount}}件）</text>
        <text class="price-value">¥{{priceHelper.formatPrice(packagingFee)}}</text>
      </view>
    </view>
  </view>
  </view>
  </scroll-view>

  <!-- 底部提交 -->
  <view class="footer">
    <view class="footer-price">
      <text class="footer-label">合计：</text>
      <text class="footer-price-num">¥{{priceHelper.formatPrice(finalPrice)}}</text>
    </view>
    <view
      class="preview-btn {{previewing || !canSubmit ? 'disabled' : ''}}"
      bind:tap="previewTicket">
      预览小票
    </view>
    <view
      class="submit-btn {{submitting || !canSubmit ? 'disabled' : ''}}"
      bind:tap="submitOrder">
      <text wx:if="{{submitting}}">提交中...</text>
      <text wx:else>提交并打印</text>
    </view>
  </view>

  <!-- 规格编辑弹窗（与购物车编辑一致） -->
  <view class="modal-mask" wx:if="{{showTagModal}}" catch:tap="closeTagModal">
    <view class="modal-dialog dish-detail-modal" catch:tap="stopPropagation">
      <view class="modal-close" bind:tap="closeTagModal">×</view>
      <scroll-view class="modal-content" scroll-y>
        <view class="dish-detail-header">
          <image class="dish-detail-image" src="{{currentDish.imageUrl || currentDish.image}}" mode="aspectFill"></image>
          <view class="dish-detail-info">
            <view class="dish-detail-name">{{currentDish.name}}</view>
            <view class="dish-detail-desc" wx:if="{{currentDish.description}}">{{currentDish.description}}</view>
            <view class="dish-detail-price">
              <text class="price-symbol">¥</text>
              <text class="price-num">{{currentDish.displayPrice != null ? currentDish.displayPrice : currentDish.price}}</text>
            </view>
          </view>
        </view>

        <block wx:for="{{currentDish.tags}}" wx:key="id" wx:for-item="tag">
          <view class="tag-section">
            <view class="tag-title">
              {{tag.name}}
              <text class="tag-type-label">{{tag.type === 'single' ? '(单选)' : '(多选)'}}</text>
              <text class="tag-required-label" wx:if="{{tag.required}}">必选</text>
            </view>

            <view class="tag-options" wx:if="{{tag.type === 'single'}}">
              <view
                class="tag-option {{option.selected ? 'selected' : ''}}"
                wx:for="{{tag.options}}"
                wx:key="id"
                wx:for-item="option"
                bind:tap="selectTagOption"
                data-tag-id="{{tag.id}}"
                data-option-id="{{option.id || option.dishId}}">
                <text>{{option.name}}</text>
                <text class="tag-option-price" wx:if="{{tag.absorbPrice && option.displayPrice > 0}}">{{priceHelper.formatAbsOptionPrice(option.displayPrice)}}</text>
                <text class="tag-option-price" wx:elif="{{!tag.absorbPrice && option.price > 0}}">{{priceHelper.formatTagOptionPrice(option.price)}}</text>
              </view>
            </view>

            <view class="tag-options" wx:if="{{tag.type === 'multiple'}}">
              <view
                wx:for="{{tag.options}}"
                wx:key="id"
                wx:for-item="option"
                class="tag-option {{option.selectedCount > 0 ? 'selected' : ''}}">
                <view
                  class="tag-option-main"
                  bind:tap="toggleTagOption"
                  data-tag-id="{{tag.id}}"
                  data-option-id="{{option.id || option.dishId}}">
                  <text>{{option.name}}</text>
                  <text class="tag-option-count" wx:if="{{option.selectedCount > 0}}">x{{option.selectedCount}}</text>
                  <text class="tag-option-price" wx:if="{{option.price > 0}}">{{priceHelper.formatTagOptionPrice(option.price)}}</text>
                </view>
                <view
                  class="tag-option-reduce"
                  wx:if="{{option.selectedCount > 0}}"
                  catch:tap="reduceTagOption"
                  data-tag-id="{{tag.id}}"
                  data-option-id="{{option.id || option.dishId}}">-</view>
              </view>
            </view>
          </view>
        </block>

        <view class="quantity-section">
          <view class="quantity-label">数量</view>
          <view class="quantity-controls">
            <view class="quantity-btn {{modalDishCount <= 1 ? 'disabled' : ''}}" bind:tap="decreaseModalCount">-</view>
            <view class="quantity-num">{{modalDishCount}}</view>
            <view class="quantity-btn" bind:tap="increaseModalCount">+</view>
          </view>
        </view>
      </scroll-view>

      <view class="modal-footer-bar">
        <view class="footer-price">
          <text class="total-label">小计：</text>
          <text class="price-symbol">¥</text>
          <text class="price-num">{{modalTotalPrice}}</text>
        </view>
        <view class="modal-footer-actions">
          <view class="modal-delete-btn" bind:tap="removeEditGoods">删除</view>
          <view class="add-cart-btn" bind:tap="confirmEditGoods">确认修改</view>
        </view>
      </view>
    </view>
  </view>

  <view class="ticket-mask" wx:if="{{showTicketPreview}}" catch:tap="closeTicketPreview">
    <view class="ticket-sheet" catch:tap="stopPropagation">
      <view class="ticket-sheet-title">小票预览</view>
      <view class="ticket-sheet-tip">仅预览，不会出纸、不会下单</view>
      <scroll-view class="ticket-sheet-body" scroll-y>
        <text class="ticket-sheet-text" decode space="ensp">{{ticketPreviewText}}</text>
      </scroll-view>
      <view class="ticket-sheet-close" bind:tap="closeTicketPreview">关闭</view>
    </view>
  </view>
</view>
