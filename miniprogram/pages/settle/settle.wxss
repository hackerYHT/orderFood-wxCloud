/* pages/settle/settle.wxss */
.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #f5f5f5;
  box-sizing: border-box;
}

.page-scroll {
  flex: 1;
  height: 0;
  min-height: 0;
}

.page-content {
  /* 与 .footer 等高：24 + 88 + 24 + safe-area */
  padding-bottom: calc(136rpx + env(safe-area-inset-bottom));
}

.section {
  background: white;
  margin-top: 20rpx;
  padding: 30rpx 0;
}

.section:first-child {
  margin-top: 0;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  padding: 0 30rpx;
  margin-bottom: 20rpx;
  letter-spacing: 0.5rpx;
}

.section-title-wrapper {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 30rpx;
  margin-bottom: 20rpx;
}

.section-title-wrapper .section-title {
  padding: 0;
  margin-bottom: 0;
}

.edit-order-btn {
  padding: 8rpx 24rpx;
  font-size: 26rpx;
  color: #e54d42;
  border: 2rpx solid #e54d42;
  border-radius: 8rpx;
  background: white;
}

.table-number-wrapper {
  padding: 0 30rpx;
}

.table-number-picker {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 80rpx;
  padding: 0 28rpx;
  font-size: 28rpx;
  background: #f8f8f8;
  border-radius: 12rpx;
  border: 2rpx solid #eee;
  box-sizing: border-box;
}

.table-number-text {
  color: #333;
}

.table-number-text.placeholder {
  color: #999;
}

.table-number-arrow {
  color: #ccc;
  font-size: 36rpx;
  line-height: 1;
}

.remark-wrapper {
  padding: 0 30rpx;
}

.remark-input {
  width: 100%;
  min-height: 120rpx;
  padding: 24rpx 28rpx;
  font-size: 28rpx;
  color: #333;
  background: #f8f8f8;
  border-radius: 12rpx;
  border: 2rpx solid #eee;
  box-sizing: border-box;
}

/* 订单类型选择 */
.order-type-list {
  display: flex;
  padding: 0 30rpx;
  gap: 20rpx;
}

.order-type-item {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  font-size: 28rpx;
  color: #666;
  background: #f5f5f5;
  border-radius: 12rpx;
  border: 2rpx solid transparent;
  transition: all 0.3s;
  cursor: pointer;
  user-select: none;
}

.order-type-item.active {
  color: #e54d42;
  background: rgba(229, 77, 66, 0.1);
  border-color: #e54d42;
  font-weight: 600;
}

.section-tip {
  margin-top: 16rpx;
  padding: 0 30rpx;
  font-size: 22rpx;
  color: #999;
  line-height: 1.4;
}

.pack-toggle {
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
  margin-top: 12rpx;
  padding: 8rpx 16rpx;
  font-size: 22rpx;
  color: #666;
  background: #f5f5f5;
  border-radius: 8rpx;
  border: 2rpx solid transparent;
  align-self: flex-start;
}

.pack-toggle.active {
  color: #e54d42;
  background: rgba(229, 77, 66, 0.08);
  border-color: #e54d42;
}

.pack-check {
  width: 28rpx;
  height: 28rpx;
  border-radius: 6rpx;
  border: 2rpx solid #ccc;
  box-sizing: border-box;
  background: #fff;
  position: relative;
  flex-shrink: 0;
}

.pack-check.checked {
  border-color: #e54d42;
  background: #e54d42;
}

.pack-check.checked::after {
  content: '';
  position: absolute;
  left: 8rpx;
  top: 2rpx;
  width: 8rpx;
  height: 14rpx;
  border: 2rpx solid #fff;
  border-top: 0;
  border-left: 0;
  transform: rotate(45deg);
}

/* 桌码显示（历史样式保留） */
.table-code-wrapper {
  padding: 0 30rpx;
}

.table-code-display {
  flex: 1;
  display: flex;
  align-items: center;
}

.table-code-label {
  font-size: 28rpx;
  color: #666;
  margin-right: 12rpx;
}

.table-code-value {
  font-size: 30rpx;
  color: #333;
  font-weight: 500;
}

.table-code-bold {
  font-weight: 600;
  font-size: 32rpx;
  color: #333;
}

.table-code-actions {
  margin-left: 20rpx;
}

.change-table-btn {
  padding: 12rpx 24rpx;
  font-size: 26rpx;
  color: #e54d42;
  border: 2rpx solid #e54d42;
  border-radius: 8rpx;
  background: white;
  cursor: pointer;
  user-select: none;
}

/* 商品列表 */
.goods-list {
  padding: 0 30rpx;
}

.goods-item {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
  transition: background-color 0.2s;
}

.goods-item:last-child {
  border-bottom: none;
}

.goods-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  justify-content: center;
  gap: 12rpx;
  flex-shrink: 0;
  margin-left: 16rpx;
}

.goods-edit-btn {
  padding: 10rpx 20rpx;
  font-size: 24rpx;
  color: #38b2ac;
  background: rgba(56, 178, 172, 0.12);
  border-radius: 8rpx;
  line-height: 1.2;
}

.goods-subtotal {
  font-size: 32rpx;
  color: #e54d42;
  font-weight: 600;
  min-width: 120rpx;
  text-align: right;
}

/* 规格编辑弹窗（与点餐页一致） */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.6);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 9999;
}

.modal-dialog.dish-detail-modal {
  width: 90%;
  max-height: 85vh;
  background: white;
  border-radius: 24rpx;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  position: relative;
}

.modal-close {
  position: absolute;
  top: 20rpx;
  left: 20rpx;
  width: 60rpx;
  height: 60rpx;
  background: rgba(0, 0, 0, 0.3);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: white;
  font-size: 48rpx;
  font-weight: 300;
  z-index: 10;
  line-height: 1;
}

.modal-content {
  flex: 1;
  overflow-y: auto;
  padding: 30rpx;
  max-height: 65vh;
  box-sizing: border-box;
}

.dish-detail-header {
  margin-bottom: 30rpx;
}

.dish-detail-image {
  width: 100%;
  height: 320rpx;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
  background: #f5f5f5;
}

.dish-detail-info {
  padding: 0 10rpx;
}

.dish-detail-name {
  font-size: 36rpx;
  color: #333;
  font-weight: bold;
  margin-bottom: 15rpx;
}

.dish-detail-desc {
  font-size: 26rpx;
  color: #999;
  line-height: 1.6;
  margin-bottom: 15rpx;
}

.dish-detail-price {
  font-size: 40rpx;
  color: #e54d42;
  font-weight: bold;
}

.dish-detail-price .price-symbol {
  font-size: 28rpx;
}

.tag-section {
  margin-bottom: 30rpx;
  padding: 25rpx;
  background: #f9f9f9;
  border-radius: 16rpx;
}

.tag-title {
  font-size: 28rpx;
  color: #333;
  margin-bottom: 20rpx;
  font-weight: bold;
  display: flex;
  align-items: center;
}

.tag-type-label {
  font-size: 22rpx;
  color: #999;
  font-weight: normal;
  margin-left: 8rpx;
}

.tag-required-label {
  font-size: 22rpx;
  color: white;
  background: #e54d42;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
  margin-left: 10rpx;
  font-weight: normal;
}

.tag-options {
  display: flex;
  flex-wrap: wrap;
  gap: 15rpx;
}

.tag-option {
  padding: 16rpx 20rpx 16rpx 30rpx;
  background: white;
  border: 2rpx solid #e5e5e5;
  border-radius: 12rpx;
  font-size: 26rpx;
  color: #666;
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.tag-option-main {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.tag-option-count {
  font-size: 22rpx;
  font-weight: bold;
  opacity: 0.9;
}

.tag-option-reduce {
  width: 44rpx;
  height: 44rpx;
  margin-left: 4rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.25);
  color: white;
  font-size: 32rpx;
  line-height: 40rpx;
  text-align: center;
  flex-shrink: 0;
}

.tag-option:not(.selected) .tag-option-reduce {
  background: #f5f5f5;
  color: #999;
}

.tag-option-price {
  color: #e54d42;
}

.tag-option.selected {
  background: linear-gradient(135deg, #e54d42 0%, #f37370 100%);
  border-color: #e54d42;
  color: white;
  font-weight: bold;
}

.tag-option.selected .tag-option-price {
  color: white;
}

.quantity-section {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 25rpx;
  background: #f9f9f9;
  border-radius: 16rpx;
  margin-top: 10rpx;
}

.quantity-label {
  font-size: 28rpx;
  color: #333;
  font-weight: bold;
}

.quantity-controls {
  display: flex;
  align-items: center;
  gap: 30rpx;
}

.quantity-btn {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #e54d42 0%, #f37370 100%);
  color: white;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  font-weight: bold;
}

.quantity-btn.disabled {
  background: #e5e5e5;
  color: #999;
}

.quantity-num {
  font-size: 32rpx;
  color: #333;
  font-weight: bold;
  min-width: 60rpx;
  text-align: center;
}

.modal-footer-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 30rpx;
  background: white;
  border-top: 2rpx solid #f5f5f5;
  flex-shrink: 0;
  gap: 16rpx;
}

.modal-footer-bar .footer-price {
  display: flex;
  align-items: baseline;
  flex-shrink: 0;
}

.total-label {
  font-size: 26rpx;
  color: #666;
  margin-right: 10rpx;
}

.modal-footer-bar .price-symbol {
  font-size: 26rpx;
  color: #e54d42;
  font-weight: bold;
}

.modal-footer-bar .price-num {
  font-size: 40rpx;
  color: #e54d42;
  font-weight: bold;
}

.modal-footer-actions {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.modal-delete-btn {
  padding: 18rpx 28rpx;
  font-size: 28rpx;
  color: #e54d42;
  background: rgba(229, 77, 66, 0.1);
  border-radius: 40rpx;
  font-weight: 600;
}

.add-cart-btn {
  padding: 18rpx 36rpx;
  background: linear-gradient(135deg, #e54d42 0%, #f37370 100%);
  color: white;
  border-radius: 40rpx;
  font-size: 28rpx;
  font-weight: bold;
}

.goods-image {
  width: 140rpx;
  height: 140rpx;
  border-radius: 16rpx;
  flex-shrink: 0;
  background: #f5f5f5;
  overflow: hidden;
}

.goods-info {
  flex: 1;
  margin-left: 24rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  min-height: 140rpx;
}

.goods-name {
  font-size: 30rpx;
  color: #333;
  font-weight: 500;
  margin-bottom: 12rpx;
  line-height: 1.4;
}

.goods-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-bottom: 10rpx;
}

.miandan-tip {
  width:190rpx;
  font-size: 22rpx;
  color: #ff6b6b;
  background: #fff3f0;
  padding: 6rpx 12rpx;
  border-radius: 6rpx;
  display: inline-block;
  margin-top: 8rpx;
  margin-bottom: 8rpx;
  border: 1rpx solid #ffe0e0;
  white-space: nowrap;
  box-sizing: border-box;
}

.goods-price-count {
  display: flex;
  align-items: center;
  gap: 15rpx;
}

.goods-price {
  font-size: 26rpx;
  color: #e54d42;
  font-weight: bold;
}

.goods-count {
  font-size: 24rpx;
  color: #999;
}

/* 价格信息 */
.price-info {
  padding: 0 30rpx;
}

.price-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 18rpx 0;
  font-size: 28rpx;
}

.price-item.total {
  font-size: 34rpx;
  font-weight: 600;
  border-top: 2rpx solid #f0f0f0;
  padding-top: 24rpx;
  margin-top: 12rpx;
}

.price-label {
  color: #666;
}

.price-value {
  color: #e54d42;
  font-weight: 600;
  font-size: 30rpx;
}

.price-item.total .price-value {
  font-size: 36rpx;
}

/* 支付方式卡片 */
.pay-method-list {
  padding: 0 30rpx;
  display: flex;
  flex-direction: row;
  gap: 16rpx;
}

.pay-method-item {
  flex: 1;
  background: #f8f8f8;
  border-radius: 16rpx;
  border: 2rpx solid transparent;
  padding: 20rpx;
  transition: all 0.3s;
  min-width: 0;
}

.pay-method-item.active {
  background: rgba(229, 77, 66, 0.08);
  border-color: #e54d42;
}

.pay-method-item.disabled {
  opacity: 0.6;
  background: #f5f5f5;
}

.pay-method-item.disabled .pay-method-title {
  color: #999;
}

.pay-method-item.disabled .pay-method-desc {
  color: #ccc;
}

.pay-method-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
}

.pay-method-left {
  width: 100%;
}

.pay-method-title {
  font-size: 26rpx;
  color: #333;
  font-weight: 500;
  margin-bottom: 8rpx;
}

.pay-method-item.active .pay-method-title {
  color: #e54d42;
  font-weight: 600;
}

.pay-method-desc {
  font-size: 22rpx;
  color: #999;
  line-height: 1.4;
}

.pay-method-item.active .pay-method-desc {
  color: #666;
}

.pay-method-radio {
  width: 32rpx;
  height: 32rpx;
  border: 2rpx solid #ddd;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-top: 12rpx;
}

.pay-method-radio.checked {
  border-color: #e54d42;
  background: #e54d42;
}

.radio-dot {
  width: 16rpx;
  height: 16rpx;
  background: white;
  border-radius: 50%;
}

/* 底部提交区域 */
.footer {
  flex-shrink: 0;
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: white;
  padding: 24rpx 30rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid #f0f0f0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  box-shadow: 0 -4rpx 24rpx rgba(0, 0, 0, 0.08);
  z-index: 100;
}

.footer-price {
  display: flex;
  align-items: baseline;
  flex: 1;
  min-width: 0;
}

.footer-label {
  font-size: 28rpx;
  color: #666;
  margin-right: 12rpx;
}

.footer-price-num {
  font-size: 44rpx;
  color: #e54d42;
  font-weight: 600;
  letter-spacing: 1rpx;
}

.submit-btn {
  width: 240rpx;
  min-width: 240rpx;
  max-width: 240rpx;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 44rpx;
  font-size: 32rpx;
  font-weight: 600;
  background-color: #e54d42;
  color: white;
  text-align: center;
  box-shadow: 0 4rpx 12rpx rgba(229, 77, 66, 0.3);
  transition: all 0.3s;
}

.submit-btn:active {
  opacity: 0.8;
  transform: scale(0.98);
}

.submit-btn.disabled {
  background-color: #ccc;
  color: #999;
  box-shadow: none;
  opacity: 0.6;
}

.submit-btn.disabled:active {
  opacity: 0.6;
  transform: none;
}



